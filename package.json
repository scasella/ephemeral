{
  "name": "ephemeral",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted disposable cloud coding workspaces for OpenAI Codex: fresh E2B microVMs, branch-scoped GitHub access and inspectable cleanup.",
  "keywords": [
    "codex",
    "openai-codex",
    "ai-coding-agent",
    "e2b",
    "microvm",
    "sandbox",
    "ephemeral-environments",
    "cloud-development-environment",
    "remote-development",
    "github-app",
    "self-hosted",
    "developer-tools"
  ],
  "homepage": "https://github.com/scasella/ephemeral#readme",
  "bugs": {
    "url": "https://github.com/scasella/ephemeral/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scasella/ephemeral.git"
  },
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup-local.sh",
    "setup:local": "node --import tsx scripts/local-setup.ts",
    "setup:doctor": "node --import tsx scripts/local-setup.ts doctor",
    "live": "node --import tsx scripts/local-setup.ts start",
    "local": "node scripts/run-local.mjs",
    "test:local": "node --test scripts/local-launcher.check.mjs",
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node scripts/run-tests.mjs",
    "test:ci": "node scripts/run-tests.mjs --maxWorkers=2",
    "test:container": "node scripts/container-smoke.mjs",
    "test:container:context": "node scripts/docker-context-check.mjs",
    "test:preview": "node scripts/local-preview-e2e.mjs --check",
    "test:preview:browser": "node scripts/local-preview-e2e.mjs --browser",
    "audit:dependencies": "npm audit --audit-level=high --fetch-retries=0 --fetch-timeout=30000",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "template:build": "node --import tsx sandbox/build-template.ts",
    "e2b:preflight": "node --import tsx scripts/e2b-preflight.ts",
    "github:register": "node --import tsx scripts/register-github-app.ts",
    "session:recovery": "node --import tsx scripts/session-recovery.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "e2b": "2.56.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
