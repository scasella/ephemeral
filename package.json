{
  "name": "ephemeral",
  "version": "0.1.0",
  "private": true,
  "description": "Disposable cloud coding sessions with scoped GitHub access; invite-only pilot.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scasella/ephemeral.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "test:container": "node scripts/container-smoke.mjs",
    "test:preview": "node scripts/local-preview-e2e.mjs --check",
    "test:preview:browser": "node scripts/local-preview-e2e.mjs --browser",
    "audit:dependencies": "npm audit --audit-level=high --fetch-retries=0 --fetch-timeout=30000",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "template:build": "node --import tsx sandbox/build-template.ts",
    "e2b:preflight": "node --import tsx scripts/e2b-preflight.ts",
    "github:register": "node --import tsx scripts/register-github-app.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "e2b": "2.56.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
