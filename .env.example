# Preview runs on localhost and never executes workloads or calls cloud services.
EPHEMERAL_MODE=preview
PORT=4310
# Live requires HTTPS reachable from your E2B sandboxes.
PUBLIC_URL=http://localhost:4310
HOST=127.0.0.1
# Optional private viewer BASE DNS origin, e.g. https://preview.example.net.
# Each generation uses <uuid>.preview.example.net; configure wildcard DNS/TLS
# and a reverse proxy preserving Host and WebSockets. IP base URLs are rejected.
# PUBLIC_URL must be outside this DNS namespace. Empty disables previews.
PREVIEW_PUBLIC_URL=
PREVIEW_PORT=4312
PREVIEW_HOST=127.0.0.1
# Explicit local testing: PREVIEW_PUBLIC_URL=http://localhost:4312, this=1,
# loopback listener, and PUBLIC_URL outside localhost (e.g. a real HTTPS tunnel).
PREVIEW_LOCAL_ONLY=0
DATA_DIR=.data
# E2B Hobby supports one hour; set 4 only with a compatible paid plan.
SESSION_MAX_HOURS=1
# Production PostgreSQL; omitted = embedded PostgreSQL via PGlite (single-process pilot).
# DATABASE_URL=postgresql://ephemeral:password@localhost:5432/ephemeral

# To enable live mode, fill every field below and set EPHEMERAL_MODE=live.
E2B_API_KEY=
E2B_TEMPLATE_ID=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Prefer an absolute mounted secret path, or GITHUB_APP_PRIVATE_KEY with escaped newlines.
GITHUB_APP_PRIVATE_KEY_FILE=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable across restarts; changing it makes stored credentials unreadable.
ENCRYPTION_KEY=
# Numeric GitHub account IDs, separated by commas. Usernames are not stable identities.
ALLOWED_GITHUB_IDS=
